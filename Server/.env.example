# Copy to `.env` and fill in real values. Never commit `.env`.

# Server
PORT=7900
NODE_ENV=development

# Session length in milliseconds (drives both JWT expiry and cookie maxAge).
# Default is 7 days if omitted.
SESSION_MAX_AGE_MS=604800000

# Comma-separated list of allowed browser origins (CORS). If omitted, sensible
# production + localhost defaults are used (see config/env.js).
# CORS_ORIGINS=https://your-frontend.example.com,http://localhost:5500

# MongoDB (users + properties)
MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/dbname

# PostgreSQL (chat messages)
DATABASE_URL=postgres://user:password@host:5432/dbname

# JWT signing secrets (use long random strings; keep buyer and seller distinct)
JWT_SECRET_BUYER=replace-with-a-long-random-secret
JWT_SECRET_SELLER=replace-with-a-different-long-random-secret

# Cloudinary (property image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
